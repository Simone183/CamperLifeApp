    "react-dom": "^19.0.1",
    "react-markdown": "^10.1.0",
    "resend": "^6.16.0",
    "sharp": "^0.35.1",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
