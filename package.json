{
  "name": "viacamper",
  "private": true,
  "version": "2.4.27",
  "description": "ViaCamper App v2.4.27",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "NODE_OPTIONS=--max-old-space-size=8192 vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
