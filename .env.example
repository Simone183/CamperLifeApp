# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Maps Platform Key
VITE_GOOGLE_MAPS_PLATFORM_KEY=

# Resend API Key for email notifications (e.g., user registration alerts)
RESEND_API_KEY=

# Admin email address to receive notifications
ADMIN_EMAIL=

# Basic Authentication to restrict access during beta testing (Optional)
# Set these on Render to password-protect the entire application during beta testing
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Registration Invitation Code to prevent public signups during beta testing (Optional)
# Set this on Render to restrict registrations to only users who know this code
REGISTRATION_INVITE_CODE=


