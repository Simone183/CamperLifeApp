<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="100%" height="100%">
  <rect width="120" height="120" rx="24" fill="#f97316"/>
  
  <!-- Mountains -->
  <path d="M20 90 L50 45 L80 90 Z" fill="#fdba74" opacity="0.6"/>
  <path d="M60 90 L85 55 L110 90 Z" fill="#fdba74" opacity="0.4"/>
  
  <!-- Tent -->
  <path d="M30 95 L60 55 L90 95 Z" fill="#ffffff"/>
  <path d="M60 55 L75 95 L45 95 Z" fill="#fed7aa"/>
  <path d="M60 70 L60 95" stroke="#f97316" stroke-width="4" stroke-linecap="round"/>
  
  <!-- Moon -->
  <circle cx="95" cy="35" r="10" fill="#ffffff" opacity="0.9"/>
  <circle cx="90" cy="30" r="10" fill="#f97316" opacity="0.9"/>
  
  <!-- Ground -->
  <rect x="20" y="95" width="80" height="4" rx="2" fill="#ffffff"/>
</svg>
