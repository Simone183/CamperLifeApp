<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 120 120" width="100%" height="100%">
  <rect width="120" height="120" rx="24" fill="#3b82f6"/>
  
  <!-- Pipe/Faucet -->
  <path d="M40 100 L40 50 C40 35 50 25 65 25 L80 25" fill="none" stroke="#ffffff" stroke-width="12" stroke-linecap="round"/>
  <rect x="70" y="15" width="10" height="20" fill="#ffffff" rx="4"/>
  <rect x="35" y="60" width="20" height="8" fill="#ffffff" rx="2"/>
  
  <!-- Drop of water -->
  <path d="M75 55 C75 55 65 70 65 80 C65 86 69 90 75 90 C81 90 85 86 85 80 C85 70 75 55 75 55 Z" fill="#93c5fd"/>
  
  <!-- Drainage grid at bottom -->
  <rect x="60" y="100" width="30" height="4" fill="#ffffff" rx="2"/>
  <rect x="65" y="108" width="20" height="4" fill="#ffffff" rx="2"/>
</svg>
